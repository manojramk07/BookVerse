rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User root document and all user-specific subcollections
    match /users/{userId} {
      // Only the authenticated owner can read and write their user document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User's personal library collection
      match /library/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's reading progress per book
      match /readingProgress/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's reading activity dates (streaks & days)
      match /readingActivity/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's achievements state
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's preferences & settings
      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
